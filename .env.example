# ===== REQUIRED =====
# Postgres. En producción corre en Docker dentro de la VM de Google (servicio "db"
# del docker-compose, host interno "db:5432"). NO se usa Neon ni Render.
# Dev local: `docker compose up -d db` y apuntar a localhost. Si la DB no responde,
# el backend cae automáticamente a JSON local en data/ (modo offline).
DB_URL=postgresql://printerapp:CHANGE_ME@localhost:5432/printer_logs

# ===== OPTIONAL (with defaults) =====
API_KEY=dev

# ===== OPTIONAL (Anthropic Claude for AI diagnosis) =====
ANTHROPIC_API_KEY=sk-ant-api03-...

# ===== OPTIONAL (HP SDS Portal - for automatic log extraction) =====
SDS_WEB_USERNAME=your-sds-username
SDS_WEB_PASSWORD=your-sds-password

# ===== OPTIONAL (HP Insight API - for real-time alerts and consumables) =====
INSIGHT_PORTAL_URL=https://hp-sds-latam.insightportal.net
INSIGHT_API_KEY=your-insight-api-key
INSIGHT_API_SECRET=your-insight-api-secret
