# ===== REQUIRED =====
# Postgres. En producción: Neon (ver docs/deploy.md). Dev local: `docker compose up -d db`
# y apuntar a localhost. Si la DB no responde, el backend cae automáticamente a JSON
# local en data/ (modo offline) — salvo que DISABLE_LOCAL_FALLBACK=true.
DB_URL=postgresql://printerapp:CHANGE_ME@localhost:5432/printer_logs

# ===== OPTIONAL (with defaults) =====
API_KEY=dev

# En Render (free tier), el spin-down por inactividad rompe los jobs en segundo plano
# (sync de flota cada 30 min, snapshots SDS 08:00/20:00 UTC). Desactivar ahí.
ENABLE_SCHEDULER=true

# En disco efímero (Render free), el fallback a JSON local puede perder datos escritos
# en un redeploy, en silencio. Activar en Render para fallar explícito en su lugar.
DISABLE_LOCAL_FALLBACK=false

# ===== OPTIONAL (Anthropic Claude for AI diagnosis) =====
ANTHROPIC_API_KEY=sk-ant-api03-...

# ===== OPTIONAL (HP SDS Portal - for automatic log extraction) =====
SDS_WEB_USERNAME=your-sds-username
SDS_WEB_PASSWORD=your-sds-password

# ===== OPTIONAL (HP Insight API - for real-time alerts and consumables) =====
INSIGHT_PORTAL_URL=https://hp-sds-latam.insightportal.net
INSIGHT_API_KEY=your-insight-api-key
INSIGHT_API_SECRET=your-insight-api-secret
