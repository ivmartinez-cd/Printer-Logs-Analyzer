{
  "name": "printer-logs-analyzer",
  "private": true,
  "description": "Monorepo root: run frontend + backend with one command",
  "scripts": {
    "postinstall": "npm install --prefix frontend",
    "dev": "concurrently -n fe,be -c blue,yellow \"npm run dev --prefix frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "taskkill /F /IM python.exe >nul 2>&1 & uvicorn backend.interface.api:app --reload --reload-dir backend --host 0.0.0.0 --port 8001",
    "format": "npm run format --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "typecheck": "npm run typecheck --prefix frontend",
    "test:frontend": "npm run test --prefix frontend",
    "test:backend": "python -m pytest backend/tests/ -v"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
